      "usage_metadata": { "input_tokens": 142, "output_tokens": 6, "total_tokens": 148, "input_token_details": { "cache_read": 100, "cache_creation": 30 } },
      "response_metadata": { "model_provider": "anthropic", "usage": { "cache_creation_input_tokens": 30, "cache_read_input_tokens": 100 } },
      "attributes": {
