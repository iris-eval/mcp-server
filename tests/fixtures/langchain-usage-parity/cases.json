      "usage_metadata": { "input_tokens": 12, "output_tokens": 6, "total_tokens": 18, "input_token_details": { "cache_read": 0, "cache_creation": 0, "ephemeral_5m_input_tokens": 0, "ephemeral_1h_input_tokens": 0 } },
      "response_metadata": {},
      "attributes": {
        "gen_ai.usage.input_tokens": 12,
        "gen_ai.usage.output_tokens": 6,
