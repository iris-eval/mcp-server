{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://iris-eval.com/response-schema-v1.json",
  "title": "Iris evaluation response (schema version 1)",
  "description": "The object the evaluate_output MCP tool returns, and the `evaluation` block POST /api/v1/traces returns when asked to evaluate. Rendered from the schema the server validates against; see https://iris-eval.com/capabilities for what each field means.",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "description": "the evaluation id, readable at iris://evaluations/{id}"
    },
    "trace_id": {
      "description": "the linked trace, when named",
      "type": "string"
    },
    "verdict": {
      "description": "state, passed, basis (which layer decided), by (the rules), risk",
      "type": "object",
      "properties": {
        "state": {
          "type": "string",
          "enum": [
            "pass",
            "fail",
            "unknown"
          ]
        },
        "passed": {
          "type": "boolean"
        },
        "basis": {
          "type": "string",
          "enum": [
            "policy_gate",
            "detector_veto",
            "critical_unknown",
            "required_evidence_missing",
            "risk_over_loss",
            "clean",
            "no_rules"
          ]
        },
        "by": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "risk": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "pBad": {
                  "type": "number"
                },
                "lo": {
                  "type": "number"
                },
                "hi": {
                  "type": "number"
                }
              },
              "required": [
                "pBad",
                "lo",
                "hi"
              ],
              "additionalProperties": {}
            },
            {
              "type": "null"
            }
          ]
        },
        "confidence": {
          "type": "string",
          "enum": [
            "decisive",
            "marginal"
          ]
        }
      },
      "required": [
        "state",
        "passed",
        "basis",
        "by",
        "risk"
      ],
      "additionalProperties": {}
    },
    "coverage": {
      "description": "per question: judged, unjudged and why, or not_applicable; plus the inputs carried",
      "type": "object",
      "properties": {
        "inputs": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "type": "boolean"
          }
        },
        "questions": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "enum": [
                  "safe_output",
                  "grounded",
                  "complete",
                  "relevant",
                  "task_completed",
                  "tool_use_correct",
                  "within_budget"
                ]
              },
              "status": {
                "type": "string",
                "enum": [
                  "judged",
                  "unjudged",
                  "not_applicable"
                ]
              },
              "why": {
                "type": "string"
              },
              "evaluated": {
                "type": "integer",
                "minimum": -9007199254740991,
                "maximum": 9007199254740991
              },
              "of": {
                "type": "integer",
                "minimum": -9007199254740991,
                "maximum": 9007199254740991
              }
            },
            "required": [
              "id",
              "status"
            ],
            "additionalProperties": {}
          }
        },
        "dormant": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "ruleId": {
                "type": "string"
              },
              "name": {
                "type": "string"
              },
              "reason": {
                "type": "string"
              }
            },
            "required": [
              "ruleId",
              "name",
              "reason"
            ],
            "additionalProperties": {}
          }
        }
      },
      "required": [
        "inputs",
        "questions"
      ],
      "additionalProperties": {}
    },
    "provenance": {
      "description": "Iris version, ruleset and config hashes, thresholds, composer facts, corpus version, time",
      "type": "object",
      "properties": {
        "irisVersion": {
          "type": "string"
        },
        "rulesetHash": {
          "type": "string"
        },
        "configHash": {
          "type": "string"
        },
        "thresholds": {
          "type": "object",
          "properties": {
            "default": {
              "type": "number"
            },
            "perRule": {
              "type": "object",
              "propertyNames": {
                "type": "string"
              },
              "additionalProperties": {}
            }
          },
          "required": [
            "default"
          ],
          "additionalProperties": {}
        },
        "composer": {
          "type": "object",
          "properties": {
            "defaultsGate": {
              "type": "boolean"
            },
            "falsePassCost": {
              "type": "number"
            },
            "onCriticalSkipped": {
              "type": "string",
              "enum": [
                "unknown",
                "fail",
                "pass"
              ]
            }
          },
          "required": [
            "defaultsGate",
            "falsePassCost",
            "onCriticalSkipped"
          ],
          "additionalProperties": {}
        },
        "corpusVersion": {
          "type": "string"
        },
        "judgedAt": {
          "type": "string"
        }
      },
      "required": [
        "irisVersion",
        "rulesetHash",
        "configHash",
        "thresholds",
        "corpusVersion",
        "judgedAt"
      ],
      "additionalProperties": {}
    },
    "run_id": {
      "description": "the run this belongs to",
      "type": "string"
    },
    "interpretations": {
      "description": "why a failed rule did not decide; unjudged questions; close calls",
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "severity": {
            "type": "string",
            "enum": [
              "block",
              "warn",
              "note"
            ]
          },
          "addressee": {
            "type": "string",
            "enum": [
              "agent",
              "operator",
              "author"
            ]
          },
          "rule": {
            "type": "string"
          },
          "text": {
            "type": "string"
          },
          "configKey": {
            "type": "string"
          }
        },
        "required": [
          "severity",
          "addressee",
          "text"
        ],
        "additionalProperties": {}
      }
    },
    "erased_at": {
      "description": "set once the linked trace was deleted",
      "type": "string"
    },
    "eval_type": {
      "type": "string",
      "enum": [
        "completeness",
        "relevance",
        "safety",
        "cost",
        "custom",
        "all"
      ],
      "description": "the bundle that ran"
    },
    "score": {
      "type": "number",
      "description": "0..1 weighted quality over the rules that ran"
    },
    "passed": {
      "type": "boolean",
      "description": "the ship verdict; false when nothing was judged"
    },
    "rule_results": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "ruleName": {
            "type": "string"
          },
          "ruleId": {
            "type": "string"
          },
          "category": {
            "type": "string",
            "enum": [
              "completeness",
              "relevance",
              "safety",
              "cost",
              "custom"
            ]
          },
          "critical": {
            "type": "boolean"
          },
          "criticalSource": {
            "type": "string",
            "enum": [
              "default",
              "config"
            ]
          },
          "passed": {
            "type": "boolean"
          },
          "score": {
            "type": "number"
          },
          "message": {
            "type": "string"
          },
          "skipped": {
            "type": "boolean"
          },
          "skipReason": {
            "type": "string"
          },
          "configInvalid": {
            "type": "boolean"
          },
          "budgetExceeded": {
            "type": "boolean"
          },
          "kind": {
            "type": "string",
            "enum": [
              "measurement",
              "detection",
              "inference",
              "judgment",
              "policy",
              "verification"
            ]
          },
          "role": {
            "type": "string",
            "enum": [
              "gate",
              "veto",
              "risk",
              "advisory"
            ]
          },
          "question": {
            "type": "string",
            "enum": [
              "safe_output",
              "grounded",
              "complete",
              "relevant",
              "task_completed",
              "tool_use_correct",
              "within_budget"
            ]
          },
          "classes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "ruleVersion": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          },
          "saw": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "output",
                "input",
                "expected",
                "tool_calls",
                "tool_outputs",
                "tools_catalogue",
                "cost",
                "tokens",
                "citations"
              ]
            }
          },
          "skipClass": {
            "type": "string",
            "enum": [
              "not_applicable",
              "defeated",
              "config_invalid"
            ]
          },
          "uncertainty": {
            "oneOf": [
              {
                "type": "object",
                "properties": {
                  "basis": {
                    "type": "string",
                    "const": "published_accuracy"
                  },
                  "fired": {
                    "type": "boolean"
                  },
                  "ppv": {
                    "type": "object",
                    "properties": {
                      "point": {
                        "type": "number"
                      },
                      "lo": {
                        "type": "number"
                      },
                      "hi": {
                        "type": "number"
                      }
                    },
                    "required": [
                      "point",
                      "lo",
                      "hi"
                    ],
                    "additionalProperties": {}
                  },
                  "missRate": {
                    "type": "object",
                    "properties": {
                      "point": {
                        "type": "number"
                      },
                      "lo": {
                        "type": "number"
                      },
                      "hi": {
                        "type": "number"
                      }
                    },
                    "required": [
                      "point",
                      "lo",
                      "hi"
                    ],
                    "additionalProperties": {}
                  },
                  "prior": {
                    "type": "object",
                    "properties": {
                      "pi": {
                        "type": "number"
                      },
                      "source": {
                        "type": "string",
                        "enum": [
                          "default",
                          "config",
                          "estimated"
                        ]
                      }
                    },
                    "required": [
                      "pi",
                      "source"
                    ],
                    "additionalProperties": {}
                  },
                  "corpus": {
                    "type": "object",
                    "properties": {
                      "n": {
                        "type": "integer",
                        "minimum": -9007199254740991,
                        "maximum": 9007199254740991
                      },
                      "tp": {
                        "type": "integer",
                        "minimum": -9007199254740991,
                        "maximum": 9007199254740991
                      },
                      "fp": {
                        "type": "integer",
                        "minimum": -9007199254740991,
                        "maximum": 9007199254740991
                      },
                      "fn": {
                        "type": "integer",
                        "minimum": -9007199254740991,
                        "maximum": 9007199254740991
                      },
                      "tn": {
                        "type": "integer",
                        "minimum": -9007199254740991,
                        "maximum": 9007199254740991
                      },
                      "version": {
                        "type": "string"
                      },
                      "release": {
                        "type": "string"
                      },
                      "labelling": {
                        "type": "string",
                        "enum": [
                          "same-model",
                          "human-verified"
                        ]
                      }
                    },
                    "required": [
                      "n",
                      "tp",
                      "fp",
                      "fn",
                      "tn",
                      "version",
                      "release",
                      "labelling"
                    ],
                    "additionalProperties": {}
                  }
                },
                "required": [
                  "basis",
                  "fired",
                  "prior",
                  "corpus"
                ],
                "additionalProperties": {}
              },
              {
                "type": "object",
                "properties": {
                  "basis": {
                    "type": "string",
                    "const": "definition"
                  },
                  "conformance": {
                    "type": "object",
                    "properties": {
                      "n": {
                        "type": "integer",
                        "minimum": -9007199254740991,
                        "maximum": 9007199254740991
                      },
                      "matched": {
                        "type": "integer",
                        "minimum": -9007199254740991,
                        "maximum": 9007199254740991
                      }
                    },
                    "required": [
                      "n",
                      "matched"
                    ],
                    "additionalProperties": {}
                  }
                },
                "required": [
                  "basis",
                  "conformance"
                ],
                "additionalProperties": {}
              },
              {
                "type": "object",
                "properties": {
                  "basis": {
                    "type": "string",
                    "const": "self_consistency"
                  },
                  "samples": {
                    "type": "integer",
                    "minimum": -9007199254740991,
                    "maximum": 9007199254740991
                  },
                  "voteFraction": {
                    "type": "number"
                  },
                  "scoreSd": {
                    "type": "number"
                  }
                },
                "required": [
                  "basis",
                  "samples",
                  "voteFraction",
                  "scoreSd"
                ],
                "additionalProperties": {}
              },
              {
                "type": "object",
                "properties": {
                  "basis": {
                    "type": "string",
                    "const": "local_labels"
                  },
                  "precision": {
                    "type": "object",
                    "properties": {
                      "point": {
                        "type": "number"
                      },
                      "lo": {
                        "type": "number"
                      },
                      "hi": {
                        "type": "number"
                      }
                    },
                    "required": [
                      "point",
                      "lo",
                      "hi"
                    ],
                    "additionalProperties": {}
                  },
                  "n": {
                    "type": "integer",
                    "minimum": -9007199254740991,
                    "maximum": 9007199254740991
                  }
                },
                "required": [
                  "basis",
                  "precision",
                  "n"
                ],
                "additionalProperties": {}
              },
              {
                "type": "object",
                "properties": {
                  "basis": {
                    "type": "string",
                    "const": "policy"
                  }
                },
                "required": [
                  "basis"
                ],
                "additionalProperties": {}
              },
              {
                "type": "object",
                "properties": {
                  "basis": {
                    "type": "string",
                    "const": "unmeasured"
                  },
                  "why": {
                    "type": "string"
                  }
                },
                "required": [
                  "basis",
                  "why"
                ],
                "additionalProperties": {}
              }
            ]
          },
          "evidence": {
            "type": "array",
            "items": {
              "oneOf": [
                {
                  "type": "object",
                  "properties": {
                    "type": {
                      "type": "string",
                      "const": "span"
                    },
                    "source": {
                      "type": "string"
                    },
                    "start": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 9007199254740991
                    },
                    "end": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 9007199254740991
                    },
                    "label": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "type",
                    "source",
                    "start",
                    "end",
                    "label"
                  ],
                  "additionalProperties": {}
                },
                {
                  "type": "object",
                  "properties": {
                    "type": {
                      "type": "string",
                      "const": "pattern"
                    },
                    "name": {
                      "type": "string"
                    },
                    "count": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 9007199254740991
                    }
                  },
                  "required": [
                    "type",
                    "name",
                    "count"
                  ],
                  "additionalProperties": {}
                },
                {
                  "type": "object",
                  "properties": {
                    "type": {
                      "type": "string",
                      "const": "toolCall"
                    },
                    "index": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 9007199254740991
                    },
                    "toolName": {
                      "type": "string"
                    },
                    "label": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "type",
                    "index",
                    "toolName",
                    "label"
                  ],
                  "additionalProperties": {}
                },
                {
                  "type": "object",
                  "properties": {
                    "type": {
                      "type": "string",
                      "const": "citation"
                    },
                    "url": {
                      "type": "string"
                    },
                    "status": {
                      "type": "string",
                      "enum": [
                        "resolved",
                        "dead",
                        "unverifiable",
                        "supported",
                        "unsupported"
                      ]
                    }
                  },
                  "required": [
                    "type",
                    "url",
                    "status"
                  ],
                  "additionalProperties": {}
                },
                {
                  "type": "object",
                  "properties": {
                    "type": {
                      "type": "string",
                      "const": "count"
                    },
                    "stat": {
                      "type": "string"
                    },
                    "unit": {
                      "type": "string"
                    },
                    "value": {
                      "type": "number"
                    },
                    "threshold": {
                      "type": "number"
                    },
                    "thresholdSource": {
                      "type": "string",
                      "enum": [
                        "default",
                        "config",
                        "call",
                        "rule"
                      ]
                    }
                  },
                  "required": [
                    "type",
                    "stat",
                    "unit",
                    "value"
                  ],
                  "additionalProperties": {}
                }
              ]
            }
          },
          "value": {
            "type": "object",
            "properties": {
              "stat": {
                "type": "string"
              },
              "unit": {
                "type": "string"
              },
              "value": {
                "type": "number"
              }
            },
            "required": [
              "stat",
              "unit",
              "value"
            ],
            "additionalProperties": {}
          }
        },
        "required": [
          "ruleName",
          "passed",
          "score",
          "message"
        ],
        "additionalProperties": {}
      },
      "description": "per rule: verdict, message, kind, role, question, saw, evidence, uncertainty"
    },
    "rules_evaluated": {
      "type": "integer",
      "minimum": -9007199254740991,
      "maximum": 9007199254740991,
      "description": "rules that judged"
    },
    "rules_skipped": {
      "type": "integer",
      "minimum": -9007199254740991,
      "maximum": 9007199254740991,
      "description": "rules that skipped"
    },
    "insufficient_data": {
      "type": "boolean",
      "description": "true when no rule could judge"
    },
    "critical_failures": {
      "description": "critical rules that failed and vetoed passed",
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "critical_skipped": {
      "description": "critical rules that could not judge; treat as unknown",
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "categories": {
      "description": "per-bundle verdicts for eval_type all",
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "score": {
            "type": [
              "number",
              "null"
            ]
          },
          "passed": {
            "type": [
              "boolean",
              "null"
            ]
          },
          "rules_evaluated": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          },
          "rules_skipped": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          },
          "insufficient_data": {
            "type": "boolean"
          },
          "critical_failures": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "critical_skipped": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "score",
          "passed",
          "rules_evaluated",
          "rules_skipped",
          "insufficient_data"
        ],
        "additionalProperties": {}
      }
    },
    "note": {
      "description": "present when eval_type was omitted",
      "type": "string"
    }
  },
  "required": [
    "id",
    "eval_type",
    "score",
    "passed",
    "rule_results",
    "rules_evaluated",
    "rules_skipped",
    "insufficient_data"
  ],
  "additionalProperties": {}
}
