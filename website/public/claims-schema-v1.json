{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://iris-eval.com/claims-schema-v1.json",
  "title": "Iris claims truthbase (schema version 1)",
  "description": "Shape of the .claims.json file at the root of github.com/iris-eval/mcp-server. The file is generated from the repository's own source, tests and package manifests (scripts/claims/generate.mjs) and is the only source every public surface may take a product number from. This schema describes the shape; the values live in the file.",
  "type": "object",
  "required": [
    "schemaVersion",
    "generatedAt",
    "generatedFromCommit",
    "generatorVersion",
    "brand",
    "evalRules",
    "llmJudgeTemplates",
    "maintenance",
    "mcpTools",
    "release",
    "security",
    "tests",
    "version",
    "capabilityMap",
    "evaluators"
  ],
  "properties": {
    "$schema": {
      "type": "string",
      "format": "uri"
    },
    "schemaVersion": {
      "const": 1
    },
    "generatedAt": {
      "type": "string",
      "format": "date-time",
      "description": "When the file was generated (ISO 8601, UTC)."
    },
    "generatedFromCommit": {
      "type": "string",
      "pattern": "^[0-9a-f]{7,40}$",
      "description": "Short or full SHA of the commit the values were read from."
    },
    "generatorVersion": {
      "$ref": "#/$defs/semver"
    },
    "proof": {
      "type": "object",
      "description": "Evaluator accuracy: proof/results.json copied verbatim by scripts/claims/generators/proof.mjs (per built-in rule: confusion matrix, precision/recall/F1, Wilson and credible 95% intervals, ppvAt; the transforms table; per-entity recall; custom-type conformance), plus proof/judge-results.json as `judge`. Optional: absent until the first measurement lands.",
      "required": [
        "schemaVersion",
        "corpusVersion",
        "generatedAt",
        "commit",
        "method",
        "rules",
        "humanAgreement",
        "judge"
      ],
      "properties": {
        "schemaVersion": {
          "const": 2
        },
        "corpusVersion": {
          "type": "string",
          "pattern": "^[0-9a-f]{12}$"
        },
        "generatedAt": {
          "type": "string",
          "format": "date-time"
        },
        "commit": {
          "type": "string"
        },
        "method": {
          "type": "object"
        },
        "rules": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "name",
              "category",
              "n",
              "positives",
              "negatives",
              "skipped",
              "tp",
              "fp",
              "fn",
              "tn",
              "precision",
              "recall",
              "f1",
              "ci95"
            ],
            "properties": {
              "name": {
                "type": "string"
              },
              "category": {
                "type": "string"
              },
              "n": {
                "type": "integer"
              },
              "positives": {
                "type": "integer"
              },
              "negatives": {
                "type": "integer"
              },
              "skipped": {
                "type": "integer"
              },
              "tp": {
                "type": "integer"
              },
              "fp": {
                "type": "integer"
              },
              "fn": {
                "type": "integer"
              },
              "tn": {
                "type": "integer"
              },
              "precision": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "recall": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "f1": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "ci95": {
                "type": "object"
              },
              "credible95": {
                "type": "object",
                "description": "Dirichlet (Jeffreys) 95% credible intervals for precision, recall and F1; unlike the bootstrap they do not collapse to [1, 1] at zero errors"
              },
              "ppvAt": {
                "type": "object",
                "description": "Positive predictive value of a fire at prevalences 0.01, 0.05, 0.2 and 0.5, from this rule's sensitivity and specificity"
              }
            }
          }
        },
        "humanAgreement": {
          "type": "object"
        },
        "judge": {
          "type": "object"
        },
        "customCorpusVersion": {
          "type": "string",
          "pattern": "^[0-9a-f]{12}$"
        },
        "transforms": {
          "type": "object",
          "description": "Recall of the three critical rules when the evidence span is transformed (zero-width, homoglyph, fullwidth, NBSP, tab, line break, case); proof/results.json → transforms"
        },
        "entities": {
          "type": "array",
          "description": "Per-entity recall for families whose positives name what they contain (no_pii): present, caught, named, recall with a Wilson interval",
          "items": {
            "type": "object"
          }
        },
        "custom": {
          "type": "object",
          "description": "Conformance of the eight custom rule types to their documented definitions under a declared config (proof/corpus/custom/<type>.json)"
        },
        "composite": {
          "type": "object",
          "description": "The verdict measured on the composite corpus: proof/composite-results.json without its per-case list (accuracy, false-block and missed-block rates, the Newcombe difference, calibration, recall by class, the threshold sweep). Absent until npm run proof -- --composite has run."
        }
      }
    },
    "brand": {
      "type": "object",
      "required": [
        "categoryName",
        "coinedTerms",
        "npmPackage",
        "publicRepoUrl",
        "securityEmail",
        "supportEmail",
        "tagline",
        "websiteUrl"
      ],
      "properties": {
        "categoryName": {
          "type": "string"
        },
        "coinedTerms": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "npmPackage": {
          "type": "string"
        },
        "publicRepoUrl": {
          "type": "string",
          "format": "uri"
        },
        "securityEmail": {
          "type": "string",
          "format": "email"
        },
        "supportEmail": {
          "type": "string",
          "format": "email"
        },
        "tagline": {
          "type": "string"
        },
        "websiteUrl": {
          "type": "string",
          "format": "uri"
        }
      },
      "additionalProperties": false
    },
    "evalRules": {
      "type": "object",
      "required": [
        "builtInCount",
        "categories",
        "categoryCount",
        "hallucinationMarkers",
        "injectionPatterns",
        "names",
        "piiPatterns",
        "stubMarkers",
        "defaultEvalType",
        "customRuleTypeCount",
        "customRuleTypes",
        "roster",
        "questions"
      ],
      "properties": {
        "builtInCount": {
          "$ref": "#/$defs/count",
          "description": "Number of built-in deterministic rules; equals names.length."
        },
        "customRuleTypeCount": {
          "$ref": "#/$defs/count",
          "description": "Number of custom-rule types a caller can deploy or pass inline; equals customRuleTypes.length (CustomRuleType in src/types/eval.ts)."
        },
        "customRuleTypes": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "The custom-rule type identifiers, in declaration order."
        },
        "roster": {
          "type": "array",
          "description": "Every built-in rule's declared metadata (0.9.0): the kind of claim, its mechanism, the inputs it reads, the question it answers, the failure classes a failure belongs to, and the definition version. Read from the rule sources; anchored to the runtime registry by tests/unit/eval/rule-metadata.test.ts.",
          "items": {
            "type": "object",
            "required": [
              "name",
              "kind",
              "mechanism",
              "needs",
              "question",
              "classes",
              "version"
            ],
            "properties": {
              "name": {
                "type": "string"
              },
              "kind": {
                "type": "string",
                "enum": [
                  "measurement",
                  "detection",
                  "inference",
                  "judgment",
                  "policy",
                  "verification"
                ]
              },
              "mechanism": {
                "type": "string",
                "enum": [
                  "formula",
                  "pattern",
                  "heuristic",
                  "model",
                  "external"
                ]
              },
              "needs": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "question": {
                "type": "string"
              },
              "classes": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "version": {
                "$ref": "#/$defs/count"
              }
            },
            "additionalProperties": false
          }
        },
        "questions": {
          "type": "array",
          "description": "The evaluation questions (src/eval/questions.ts): the vocabulary of coverage and of the public capability map.",
          "items": {
            "type": "object",
            "required": [
              "id",
              "text",
              "answeredBy"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "text": {
                "type": "string"
              },
              "answeredBy": {
                "type": "string",
                "enum": [
                  "rule",
                  "tool",
                  "surface"
                ]
              }
            },
            "additionalProperties": false
          }
        },
        "categories": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Rule categories (the eval_type bundles)."
        },
        "categoryCount": {
          "$ref": "#/$defs/count"
        },
        "hallucinationMarkers": {
          "$ref": "#/$defs/nullableCount",
          "description": "Context-grounded signals in no_hallucination_markers."
        },
        "injectionPatterns": {
          "$ref": "#/$defs/nullableCount",
          "description": "Patterns in no_injection_patterns."
        },
        "names": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Built-in rule identifiers, camelCase as exported from src/eval/rules."
        },
        "piiPatterns": {
          "$ref": "#/$defs/nullableCount",
          "description": "Patterns in no_pii."
        },
        "stubMarkers": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Placeholder markers no_stub_output looks for."
        },
        "defaultEvalType": {
          "type": "string",
          "enum": [
            "completeness",
            "relevance",
            "safety",
            "cost",
            "custom",
            "all"
          ],
          "description": "What evaluate_output evaluates when the caller omits eval_type (DEFAULT_EVAL_TYPE in src/eval/engine.ts)."
        }
      },
      "additionalProperties": false
    },
    "llmJudgeTemplates": {
      "type": "object",
      "required": [
        "count",
        "names",
        "supportedModels",
        "supportedProviders",
        "enable"
      ],
      "properties": {
        "count": {
          "$ref": "#/$defs/count"
        },
        "names": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "supportedModels": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Model IDs the judge has pricing for. Aliases of one model are listed once."
        },
        "supportedProviders": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "anthropic",
              "openai"
            ]
          }
        },
        "enable": {
          "type": "object",
          "description": "The judge enable workflow, from src/judge-enablement.json — the runtime, the error recovery, the README, the docs and the skill files all render this.",
          "required": [
            "title",
            "steps"
          ],
          "properties": {
            "title": {
              "type": "string"
            },
            "steps": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string"
              }
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "maintenance": {
      "type": "object",
      "description": "MEASURED issue-close latency from the public GitHub issues API (pull requests excluded), sampled on demand by scripts/claims/generators/issues.mjs. The only block in the file that is a measurement rather than a value read from source; `sampledAt` says when, `source` says whether the sample came from the API ('live') or was kept from the previous commit because the API was unreachable ('cached').",
      "required": [
        "issues",
        "method",
        "repo",
        "sampledAt",
        "source",
        "windowDays"
      ],
      "properties": {
        "issues": {
          "type": "object",
          "required": [
            "closedAsCompleted",
            "closedAsNotPlanned",
            "closedInWindow",
            "medianHoursToClose",
            "openNow",
            "p75HoursToClose"
          ],
          "properties": {
            "closedAsCompleted": {
              "$ref": "#/$defs/count"
            },
            "closedAsNotPlanned": {
              "$ref": "#/$defs/count"
            },
            "closedInWindow": {
              "$ref": "#/$defs/count",
              "description": "Issues whose closed_at falls inside the last windowDays days; the n behind the two percentiles."
            },
            "medianHoursToClose": {
              "type": [
                "number",
                "null"
              ],
              "minimum": 0,
              "description": "Median of closed_at minus created_at in hours; null when closedInWindow is 0."
            },
            "openNow": {
              "$ref": "#/$defs/count"
            },
            "p75HoursToClose": {
              "type": [
                "number",
                "null"
              ],
              "minimum": 0
            }
          },
          "additionalProperties": false
        },
        "method": {
          "type": "string"
        },
        "repo": {
          "type": "string",
          "pattern": "^[^/]+/[^/]+$"
        },
        "sampledAt": {
          "type": "string",
          "format": "date-time"
        },
        "source": {
          "type": "string",
          "enum": [
            "live",
            "cached"
          ]
        },
        "windowDays": {
          "$ref": "#/$defs/count"
        }
      },
      "additionalProperties": false
    },
    "mcpTools": {
      "type": "object",
      "required": [
        "annotations",
        "count",
        "names"
      ],
      "properties": {
        "annotations": {
          "type": "object",
          "required": [
            "destructiveHintCount",
            "openWorldHintCount",
            "readOnlyHintCount"
          ],
          "properties": {
            "destructiveHintCount": {
              "$ref": "#/$defs/count"
            },
            "openWorldHintCount": {
              "$ref": "#/$defs/count"
            },
            "readOnlyHintCount": {
              "$ref": "#/$defs/count"
            }
          },
          "additionalProperties": false
        },
        "count": {
          "$ref": "#/$defs/count",
          "description": "Registered MCP tools; equals names.length."
        },
        "names": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "release": {
      "type": "object",
      "required": [
        "currentReleaseDate",
        "currentReleaseHeadline",
        "currentReleaseVersion",
        "nextPlannedScope",
        "nextPlannedVersion"
      ],
      "properties": {
        "currentReleaseDate": {
          "oneOf": [
            {
              "type": "string",
              "format": "date"
            },
            {
              "type": "null"
            }
          ]
        },
        "currentReleaseHeadline": {
          "type": [
            "string",
            "null"
          ],
          "description": "The CHANGELOG's bold lead line for the current release, or null when it has none."
        },
        "currentReleaseVersion": {
          "oneOf": [
            {
              "$ref": "#/$defs/semver"
            },
            {
              "type": "null"
            }
          ]
        },
        "nextPlannedScope": {
          "type": [
            "string",
            "null"
          ]
        },
        "nextPlannedVersion": {
          "oneOf": [
            {
              "$ref": "#/$defs/semver"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "security": {
      "type": "object",
      "required": [
        "apiKeyRequiredByDefault",
        "defaultBindHost",
        "disclosure",
        "limits",
        "rateLimit"
      ],
      "properties": {
        "apiKeyRequiredByDefault": {
          "type": "boolean"
        },
        "disclosure": {
          "type": "object",
          "description": "The vulnerability-disclosure SLA, parsed out of SECURITY.md by scripts/claims/generators/security-policy.mjs so the policy file and the website cannot state two different promises.",
          "required": [
            "acknowledgeWithinHours",
            "detailedResponseWithinBusinessDays",
            "publicDisclosureWindowDays",
            "source"
          ],
          "properties": {
            "acknowledgeWithinHours": {
              "$ref": "#/$defs/count"
            },
            "detailedResponseWithinBusinessDays": {
              "$ref": "#/$defs/count"
            },
            "publicDisclosureWindowDays": {
              "$ref": "#/$defs/count",
              "description": "Default coordinated-disclosure window asked of reporters, in days."
            },
            "source": {
              "const": "SECURITY.md"
            }
          },
          "additionalProperties": false
        },
        "limits": {
          "type": "object",
          "description": "Shipped configuration defaults, each read from the line of source that enforces it. Configuration, not measurement.",
          "required": [
            "customRegexMaxLength",
            "regexBreachesPerEvaluation",
            "regexMatchBudgetMs",
            "requestSizeLimit"
          ],
          "properties": {
            "customRegexMaxLength": {
              "$ref": "#/$defs/count",
              "description": "Longest custom regex source accepted (characters)."
            },
            "regexBreachesPerEvaluation": {
              "$ref": "#/$defs/count",
              "description": "Sandbox budget breaches after which the remaining regex rules in one evaluation skip."
            },
            "regexMatchBudgetMs": {
              "$ref": "#/$defs/count",
              "description": "Hard per-match deadline for a user-supplied regex, in milliseconds."
            },
            "requestSizeLimit": {
              "type": "string",
              "description": "express.json body limit on the dashboard API and the HTTP transport, e.g. '1mb'."
            }
          },
          "additionalProperties": false
        },
        "defaultBindHost": {
          "type": "object",
          "required": [
            "dashboard",
            "transport"
          ],
          "properties": {
            "dashboard": {
              "type": "string"
            },
            "transport": {
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        "rateLimit": {
          "type": "object",
          "required": [
            "api",
            "mcp"
          ],
          "properties": {
            "api": {
              "$ref": "#/$defs/count",
              "description": "Requests per minute on the dashboard REST API (/api/v1/*)."
            },
            "mcp": {
              "$ref": "#/$defs/count",
              "description": "Requests per minute on the HTTP MCP endpoint (POST/DELETE /mcp)."
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "tests": {
      "type": "object",
      "required": [
        "integration",
        "playwrightE2E",
        "totalCombined",
        "vitestDashboard",
        "vitestRoot"
      ],
      "properties": {
        "integration": {
          "$ref": "#/$defs/testSuite"
        },
        "playwrightE2E": {
          "allOf": [
            {
              "$ref": "#/$defs/testSuite"
            },
            {
              "type": "object",
              "properties": {
                "browsers": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              }
            }
          ]
        },
        "totalCombined": {
          "$ref": "#/$defs/nullableCount"
        },
        "vitestDashboard": {
          "$ref": "#/$defs/testSuite"
        },
        "vitestRoot": {
          "$ref": "#/$defs/testSuite"
        }
      },
      "additionalProperties": false
    },
    "version": {
      "type": "object",
      "required": [
        "dashboardPackage",
        "initPackage",
        "langchainPackage",
        "mcpServer",
        "published",
        "websitePackage"
      ],
      "properties": {
        "dashboardPackage": {
          "oneOf": [
            {
              "$ref": "#/$defs/semver"
            },
            {
              "type": "null"
            }
          ]
        },
        "initPackage": {
          "oneOf": [
            {
              "$ref": "#/$defs/semver"
            },
            {
              "type": "null"
            }
          ]
        },
        "langchainPackage": {
          "oneOf": [
            {
              "$ref": "#/$defs/semver"
            },
            {
              "type": "null"
            }
          ]
        },
        "published": {
          "type": "object",
          "description": "Whether each npm-facing package is on the npm registry. Recorded in the generator, not probed: a false entry means the package is in-repo only and no surface may present it as installable.",
          "required": [
            "initPackage",
            "langchainPackage",
            "mcpServer"
          ],
          "properties": {
            "initPackage": {
              "type": "boolean"
            },
            "langchainPackage": {
              "type": "boolean"
            },
            "mcpServer": {
              "type": "boolean"
            }
          },
          "additionalProperties": false
        },
        "mcpServer": {
          "$ref": "#/$defs/semver"
        },
        "websitePackage": {
          "oneOf": [
            {
              "$ref": "#/$defs/semver"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "capabilityMap": {
      "type": "object",
      "description": "The public capability map, read verbatim from capability-map.json: ten evaluation questions by six subjects, one of four statuses per cell, evidence names that resolve to registered things (tests/capability-map-contract.test.ts).",
      "required": [
        "version",
        "about",
        "questions",
        "subjects",
        "cells",
        "counts",
        "total"
      ],
      "properties": {
        "version": {
          "type": "integer"
        },
        "about": {
          "type": "string"
        },
        "questions": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "registryId",
              "text"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "registryId": {
                "type": "string"
              },
              "text": {
                "type": "string"
              }
            },
            "additionalProperties": false
          }
        },
        "subjects": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "text"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "text": {
                "type": "string"
              }
            },
            "additionalProperties": false
          }
        },
        "cells": {
          "type": "array",
          "minItems": 60,
          "maxItems": 60,
          "items": {
            "type": "object",
            "required": [
              "id",
              "question",
              "subject",
              "status",
              "summary",
              "evidence",
              "needs"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^Q(10|[1-9])xS[1-6]$"
              },
              "question": {
                "type": "string"
              },
              "subject": {
                "type": "string"
              },
              "status": {
                "type": "string",
                "enum": [
                  "has",
                  "partial",
                  "gap",
                  "n/a"
                ]
              },
              "summary": {
                "type": "string"
              },
              "evidence": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "kind",
                    "name"
                  ],
                  "properties": {
                    "kind": {
                      "type": "string",
                      "enum": [
                        "rule",
                        "tool",
                        "resource",
                        "route",
                        "proof",
                        "template"
                      ]
                    },
                    "name": {
