{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "git": {
    "deploymentEnabled": {
      "dependabot/**": false
    }
  },
  "ignoreCommand": "git diff --quiet \"${VERCEL_GIT_PREVIOUS_SHA:-HEAD^}\" HEAD -- ':(top)' ':(top,exclude)dashboard' ':(top,exclude)tests' ':(top,exclude)packages' ':(top,exclude).github'"
}
