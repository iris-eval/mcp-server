{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "CommonJS",
    // Bundler, not Node10: TypeScript 6 deprecates Node10 and TypeScript 7 removes it. The
    // CommonJS this emits is byte for byte the Node10 build's (compared on TypeScript 6.0.3).
    "moduleResolution": "Bundler",
    "outDir": "dist/cjs"
  }
}
